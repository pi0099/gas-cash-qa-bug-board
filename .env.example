# Optional — when both are set, the board uses Supabase for live status, comments, and Edit.
# Until then, the SPA falls back to localStorage (per-browser).
# Set these as GitHub Actions secrets with the same names for Pages builds.
# Never commit real values or service_role keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — Google Sheets iframe embed URL for an alternate Test Cases tab.
# Leave empty to use the native spreadsheet grid only (default).
VITE_TC_SHEET_EMBED_URL=
